# Copy to .env and fill in. Every variable below is read in src/config/index.ts
# (or prisma.config.ts for DATABASE_URL). Values shown are local-dev defaults.

# --- Database (required) ---------------------------------------------------
# Used by Prisma for migrations and by the API at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stellflow?schema=public"

# --- Auth (required) -------------------------------------------------------
# Signs 15-minute access tokens. Generate with: openssl rand -hex 32
JWT_SECRET=""
# Signs 7-day refresh tokens (set as an HTTP-only cookie). Must differ from
# JWT_SECRET. Login and register fail if this is empty.
JWT_REFRESH_SECRET=""
# Note: token lifetimes are fixed in src/config/index.ts (900s / 604800s);
# there is no JWT_EXPIRES_IN variable.

# --- Server ----------------------------------------------------------------
PORT=3001
NODE_ENV="development"
# Origin allowed by CORS and by the socket.io server (single origin).
CORS_ORIGIN="http://localhost:3000"

# --- Stellar ---------------------------------------------------------------
# Horizon is used to check that a wallet address exists before issuing a
# link challenge (src/services/wallet-verification.service.ts).
STELLAR_NETWORK="testnet"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"

# --- AWS S3 (file uploads) -------------------------------------------------
# Only needed for avatar / invoice-attachment uploads. Leave blank otherwise.
AWS_REGION="us-east-1"
AWS_S3_BUCKET="stellflow-uploads"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Uncomment to point at a local S3-compatible store such as MinIO.
# AWS_S3_ENDPOINT="http://localhost:9000"
# AWS_S3_FORCE_PATH_STYLE="true"
